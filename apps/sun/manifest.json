{
  "name": "sun",
  "title": "Sun and Moon",
  "author": "Perinkpheral",
  "description": "Sunrise, sunset and the moon's phase",
  "version": "0.1.18",
  "abi": 3,
  "format": "raw",
  "writes_files": true,
  "icon": [
    "...........",
    ".....#.....",
    ".#.......#.",
    "...........",
    "....###....",
    "...#...#...",
    "##.#...#.##",
    "...#...#...",
    "###########",
    "...........",
    "..........."
  ],
  "settings": [
    {
      "key": "city",
      "type": "place",
      "title": "City",
      "latitude": "lat",
      "longitude": "lon"
    },
    {
      "key": "lat",
      "type": "number",
      "title": "Latitude"
    },
    {
      "key": "lon",
      "type": "number",
      "title": "Longitude"
    },
    {
      "key": "header_city",
      "type": "toggle",
      "title": "City in header",
      "default": "1"
    },
    {
      "key": "rise_notice",
      "type": "choice",
      "title": "Sunrise notification",
      "options": [
        "Off",
        "At the time",
        "5 min",
        "15 min",
        "30 min",
        "1 h"
      ],
      "default": "Off"
    },
    {
      "key": "set_notice",
      "type": "choice",
      "title": "Sunset notification",
      "options": [
        "Off",
        "At the time",
        "5 min",
        "15 min",
        "30 min",
        "1 h"
      ],
      "default": "Off"
    }
  ],
  "intents": [
    "started",
    "time_changed"
  ]
}
