#!/bin/sh
# SPDX-License-Identifier: MIT
# The compatibility checker must allow a bounded retry and reject a lost retry.
set -eu
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
scratch=$(mktemp -d "${TMPDIR:-/tmp}/check-recovery-test.XXXXXX")
trap 'rm -rf "$scratch"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
cp -R "$here/recovery" "$scratch/recovery"
"$here/../app-check" "$scratch/recovery" --only network
sed 's/#define RECOVERY_BROKEN 0/#define RECOVERY_BROKEN 1/' \
    "$here/recovery/recovery.c" > "$scratch/recovery/recovery.c"
if "$here/../app-check" "$scratch/recovery" --only network > "$scratch/broken.log" 2>&1; then
    cat "$scratch/broken.log"
    echo 'FAIL: permanent recovery failure was accepted' >&2
    exit 1
fi
grep -Eq 'FAIL recovery +network' "$scratch/broken.log" || { cat "$scratch/broken.log"; exit 1; }
cp "$here/recovery/recovery.c" "$scratch/recovery/recovery.c"
sed '/network_recovery_seconds/d' "$here/recovery/test/check.json" > "$scratch/recovery/test/check.json"
if "$here/../app-check" "$scratch/recovery" --only network > "$scratch/immediate.log" 2>&1; then
    cat "$scratch/immediate.log"
    echo 'FAIL: the default immediate-recovery contract was changed' >&2
    exit 1
fi
grep -Eq 'FAIL recovery +network' "$scratch/immediate.log" || { cat "$scratch/immediate.log"; exit 1; }
echo 'Network checker: bounded recovery passes; permanent failure and immediate retry fail.'
