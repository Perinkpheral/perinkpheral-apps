 /* ---- Network: an answer however it arrives ---- */
 
+/* Optional test/check.json bound for applications that deliberately back off. The control
+ * and failure runs advance by the same uptime, so clocks/countdowns remain comparable. */
+static int32_t recovery_seconds(void)
+{
+    FILE *file = fopen("test/check.json", "rb");
+    if (file == NULL) { return 0; }
+    static const char *const paths[] = { "network_recovery_seconds" };
+    json_pick_t pick;
+    json_pick_init(&pick, paths, 1);
+    char bytes[1024];
+    size_t length;
+    bool valid = true;
+    while ((length = fread(bytes, 1, sizeof bytes, file)) > 0) {
+        valid = json_pick_feed(&pick, bytes, length) && valid;
+    }
+    valid = !ferror(file) && json_pick_finish(&pick) && valid;
+    fclose(file);
+    const char *value = json_pick_value(&pick, 0);
+    if (!valid || value == NULL) { return 0; }
+    char *end;
+    long seconds = strtol(value, &end, 10);
+    if (!*value || *end || seconds < 0 || seconds > SECONDS_PER_DAY) {
+        problem(NETWORK, "network_recovery_seconds must be an integer from 0 to 86400");
+        return 0;
+    }
+    return (int32_t)seconds;
+}
