{
  "name": "space-launch",
  "title": "Space Launch",
  "author": "Perinkpheral",
  "description": "Space launches, upcoming and past",
  "version": "0.1.7",
  "abi": 3,
  "format": "json",
  "writes_files": true,
  "intents": [
    "started",
    "time_changed",
    "network_up"
  ],
  "settings": [
    {
      "key": "remind",
      "type": "choice",
      "title": "Reminder",
      "options": [
        "Off",
        "15 min",
        "1 h"
      ],
      "default": "Off"
    }
  ],
  "icon": [
    ".....#.....",
    "....###....",
    "...##.##...",
    "...#...#...",
    "...#####...",
    "...#...#...",
    "..##...##..",
    ".###...###.",
    "...#####...",
    "....#.#....",
    ".....#....."
  ],
  "hosts": [
    "ll.thespacedevs.com"
  ],
  "polls": [
    {
      "url": "https://ll.thespacedevs.com/2.3.0/launches/upcoming/?format=json&mode=normal&limit=10&ordering=net&hide_recent_previous=false",
      "headers": {
        "Accept": "application/json",
        "User-Agent": "perinkpheral-space-launch"
      },
      "pick": [
        "results[*].id",
        "results[*].name",
        "results[*].net",
        "results[*].status.id",
        "results[*].net_precision.id",
        "results[*].launch_service_provider.name",
        "results[*].pad.location.name",
        "count"
      ],
      "manual": true
    },
    {
      "url": "https://ll.thespacedevs.com/2.3.0/launches/previous/?format=json&mode=normal&limit=10&ordering=-net&hide_recent_previous=false",
      "headers": {
        "Accept": "application/json",
        "User-Agent": "perinkpheral-space-launch"
      },
      "pick": [
        "results[*].id",
        "results[*].name",
        "results[*].net",
        "results[*].status.id",
        "results[*].net_precision.id",
        "results[*].launch_service_provider.name",
        "results[*].pad.location.name",
        "count"
      ],
      "manual": true
    },
    {
      "url": "https://ll.thespacedevs.com/2.3.0/launches/previous/?format=json&mode=normal&limit=10&ordering=id&offset={{offset}}&year={{yr}}&status__ids=3,4,7&include_suborbital=false",
      "headers": {
        "Accept": "application/json",
        "User-Agent": "perinkpheral-space-launch"
      },
      "pick": [
        "results[*].id",
        "unused",
        "results[*].net",
        "results[*].status.id",
        "unused2",
        "unused_provider",
        "unused_site",
        "count",
        "results[*].launch_service_provider.id"
      ],
      "manual": true
    }
  ],
  "firmware": "0.2.0"
}
