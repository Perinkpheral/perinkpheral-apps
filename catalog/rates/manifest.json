{
  "name": "rates",
  "title": "Exchange rates",
  "author": "Perinkpheral",
  "description": "Exchange rates of the Bank of Russia",
  "version": "0.1.14",
  "abi": 3,
  "format": "xml",
  "fullscreen": false,
  "hosts": [
    "www.cbr-xml-daily.ru",
    "www.cbr.ru"
  ],
  "certificates": [
    "russian-root-ca.pem"
  ],
  "intents": [
    "started",
    "network_up"
  ],
  "polls": [
    {
      "url": "https://www.cbr-xml-daily.ru/daily_json.js",
      "format": "json",
      "every": "{{every}}"
    }
  ],
  "settings": [
    {
      "key": "codes",
      "type": "list",
      "title": "Currencies",
      "help": "Up to 8.",
      "default": [
        "USD",
        "EUR",
        "CNY"
      ]
    },
    {
      "key": "every",
      "type": "choice",
      "title": "Refresh",
      "options": [
        "1 h",
        "6 h",
        "1 d"
      ],
      "default": "6 h"
    },
    {
      "key": "rotate",
      "type": "choice",
      "title": "Rotation",
      "options": [
        "1 min",
        "2 min",
        "5 min",
        "10 min"
      ],
      "default": "1 min"
    }
  ],
  "icon": [
    "...........",
    ".....#.....",
    "..#######..",
    ".#...#.....",
    ".#...#.....",
    "..#######..",
    ".....#...#.",
    ".....#...#.",
    "..#######..",
    ".....#.....",
    "..........."
  ],
  "writes_files": true,
  "firmware": "0.1.30"
}
